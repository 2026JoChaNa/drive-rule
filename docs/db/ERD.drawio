        <mxCell id="LG_Z0" value="서버 DB · MySQL 8.4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=light-dark(#cce5ff,#1d3a5c);strokeColor=#36393d;" vertex="1" parent="1">
