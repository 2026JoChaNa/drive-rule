ryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_C10" target="p2_C12"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p2_note" value="&lt;b&gt;알아 둘 것&lt;/b&gt;&lt;br&gt;• 검수 요청 때 서버가 칸 사이 규칙 · 조건 표를 검사한다&lt;br&gt;• 고친 뒤 다시 요청하면 버전이 오르고, 앞 버전 승인은 세지 않는다&lt;br&gt;• 차로 나가는 것은 게시된 카드와 회수된 카드 ID뿐이다&lt;br&gt;• 회수는 어느 단계에서든 할 수 있다 (회수된 카드 제외)&lt;br&gt;• 주제 하나에 대표 카드 1장 — Gleo 가 이 카드로 답한다" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=light-dark(#fffbe6,#3a3520);strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="440" height="220" as="geometry"/></mxCell><mxCell id="p2_lg" value="범례" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1040" y="490" width="440" height="160" as="geometry"/></mxCell><mxCell id="p2_lg0" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_lg0t" value="시작 · 끝" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="520" width="140" height="30" as="geometry"/></mxCell><mxCell id="p2_lg1" value="" style="rounded=0;fillColor=light-dark(#dae8fc,#1d3a5c);strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_lg1t" value="처리" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="520" width="140" height="30" as="geometry"/></mxCell><mxCell id="p2_lg2" value="" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="40" height="30" as="