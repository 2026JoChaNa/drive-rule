oundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A4" target="p5_A5"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A5" target="p5_A6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e9" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A6" target="p5_A6b"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A6b" target="p5_A2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="860"/><mxPoint x="120" y="380"/></Array></mxGeometry></mxCell><mxCell id="p5_e11" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A6" target="p5_A7"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e12" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A7" target="p5_H1"><mxGeometry relative="1" x="-0.4" as="geometry"><Array as="points"><mxPoint x="960" y="980"/><mxPoint x="960" y="500"/></Array></mxGeometry></mxCell><mxCell id="p5_e13" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A7" target="p5_A8"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_A8" target="p5_A9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_note" value="&lt;b&gt;알아 둘 것&lt;/b&gt;&lt;br&gt;• 질문할 때 서버에 아무것도 보내지 않는다. 차 사본으로 7초 안에 답한다&lt;br&gt;• 주제가 기타면 카드가 없어 항상 답변 보류&lt;br&gt;• 조건: 우회전 신호등 · 전방 신호 · 보행 신호 · 보행자&lt;br&gt;• 모른다고 한 조건은 비워 둔다. 후보가 3개 이상이면 되묻는다&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;정해지지 않은 것&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Gleo 가 검수 문장을 바꿔 말하지 않는지 (11/18 검증)" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=light-dark(#fffbe6,#3a3520);strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="440" height="260" as="geometry"/></mxCell><mxCell id="p5_lg" value="범례" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1040" y="530" width="440" height="160" as="geometry"/></mxCell><mxCell id="p5_lg0" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="50" height="30" as="geometry"/></mxCell><mxCell id="p5_lg0t" value="시작 · 끝" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="560" width="140" height="30" as="geometry"/></mxCell><mxCell id="p5_lg1" value="" style="rounded=0;fillColor=light-dark(#dae8fc,#1d3a5c);strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1270" y="560" width="50" height="30" as="geometry"/></mxCell><mxCell id="p5_lg1t" value="처리" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="560" width="140" height="30" as="geometry"/></mxCell><mxCell id="p5_lg2" value="" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="40" height="30" as="geometry"/></mxCell><mxCell id="p5_lg2t" value="판단" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="140" height="30" as="geometry"/></mxCell><mxCell id="p5_lg3" value="" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=light-dark(#fff2cc,#4a3d12);strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="50" height="30" as="geometry"/></mxCell><mxCell id="p5_lg3t" value="저장 · 기록" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="600" width="140" height="30" as="geometry"/></mxCell><mxCell id="p5_lg4" value="" style="rounded=0;dashed=1;strokeWidth=2;fillColor=light-dark(#ffffff,#1a1a1a);strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="50" height="30" as="geometry"/></mxCell><mxCell id="p5_lg4t" value="차 밖으로 나가는 데이터" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="640" width="140" height="30" as="geometry"/></mxCell><mxCell id="p5_lg5" value="" style="rounded=1;arcSize=50;fill