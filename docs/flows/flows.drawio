;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_E6" target="p4_E7"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_E7" target="p4_E8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_E8" target="p4_E9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e12" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_E9" target="p4_E9y"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e13" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_E9" target="p4_E10"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p4_note" value="&lt;b&gt;알아 둘 것&lt;/b&gt;&lt;br&gt;• 이벤트: 어린이보호구역 진입 · 주정차 · 우회전 후 횡단보도&lt;br&gt;• 사본 카드 조건: 게시됨 · 회수 안 됨 · 일반 운전자 대상&lt;br&gt;• 이미 받았나는 차 안 기록으로만 본다. 서버는 모른다&lt;br&gt;• 그래서 한 카드는 프로필마다 시행 전 1번, 시행 후 1번 나온다&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;정해지지 않은 것&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• 시행일이 지난 뒤 처음 받은 카드에 공포 안내도 하는지&lt;br&gt;• 확인하지 않았을 때 다시 띄우는 규칙&lt;br&gt;• 2건을 넘을 때 무엇을 먼저 고르는지" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=light-dark(#fffbe6,#3a3520);strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="440" height="330" as="geometry"/></mxCell><mxCell id="p4_lg" value="범례" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="440" height="160" as="geometry"/></mxCell><mxCell id="p4_lg0" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="630" width="50" height="30" as="geometry"/></mxCell><mxCell id="p4_lg0t" value="시작 · 끝" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="630" width="140" height="30" as="geometry"/></mxCell><mxCell id="p4_lg1" value="" style="rounded=0;fillColor=light-dark(#dae8fc,#1d3a5c);strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="630" width="50" height="30" as="geometry"/></mxCell><mxCell id="p4_lg1t" value="처리" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="630" width="140" height="30" as="geometry"/></mxCell><mxCell id="p4_lg2" value="" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="670" width="40" height="30" as="geometry"/></mxCell><mxCell id="p4_lg2t" value="판단" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="670" width="140" height="30" as="geometry"/></mxCell><mxCell id="p4_lg3" value="" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=light-dark(#fff2cc,#4a3d12);strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="670" width="50" height="30" as="geometry"/></mxCell><mxCell id="p4_lg3t" value="저장 · 기록" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="670" width="140" height="30" as="geometry"/></mxCell><mxCell id="p4_lg4" value="" style="rounded=0;dashed=1;strokeWidth=2;fillColor=light-dark(#ffffff,#1a1a1a);strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="710" width="50" height="30" as="geometry"/></mxCell><mxCell id="p4_lg4t" value="차 밖으로 나가는 데이터" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="710" width="140" height="30" as="geometry"/></mxCell><mxCell id="p4_lg5" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#eeeeee,#333333);strokeColor=#999999;fontColor=light-dark(#555555,#bbbbbb);html=1;" vertex="1" parent="1"><mxGeometry x="990" y="710" width="50" height="30" as="geometry"/></mxCell><mxCell id="p4_lg5t" value="안내 · 처리 안 함" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="710" width="140" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow-5" name="⑤ Gleo 규칙 묻기"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_title" value="⑤ Gleo 규칙 묻기 — 차량 (핵심 기능 2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="1360" height="40" as="geometry"/></mxCell><mxCell id="p5_A1" value="운전자가 규칙을 물음&#xa;예: 우회전 어떻게 해?" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="230" w