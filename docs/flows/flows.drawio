><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p3_e12" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_S9" target="p3_S10"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="p3_note" value="&lt;b&gt;알아 둘 것&lt;/b&gt;&lt;br&gt;• 서버는 모든 차에 같은 답을 준다. 차 · 사용자를 구분하지 않는다&lt;br&gt;• 목록에 없다고 사본을 지우지 않는다. 내리는 신호는 회수 ID뿐&lt;br&gt;• 게시 후 수정 · 검수 중인 카드는 차에 마지막 게시본이 남는다&lt;br&gt;• 보호구역 사본이 없으면 보호구역 · 목적지 안내는 쉰다 (틀린 안내보다 안내 없음)" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=light-dark(#fffbe6,#3a3520);strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="440" height="190" as="geometry"/></mxCell><mxCell id="p3_lg" value="범례" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="440" height="160" as="geometry"/></mxCell><mxCell id="p3_lg0" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="490" width="50" height="30" as="geometry"/></mxCell><mxCell id="p3_lg0t" value="시작 · 끝" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="490" width="140" height="30" as="geometry"/></mxCell><mxCell id="p3_lg1" value="" style="rounded=0;fillColor=light-dark(#dae8fc,#1d3a5c);strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="490" width="50" height="30" as="geometry"/></mxCell><mxCell id="p3_lg1t" value="처리" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="490" width="140" height="30" as="geometry"/></mxCell><mxCell id="p3_lg2" value="" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="530" width="40" height="30" as="geometry"/></mxCell><mxCell id="p3_lg2t" value="판단" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="530" width="140" height="30" as="geometry"/></mxCell><mxCell id="p3_lg3" value="" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=light-dark(#fff2cc,#4a3d12);strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="530" width="50" height="30" as="geometry"/></mxCell><mxCell id="p3_lg3t" value="저장 · 기록" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="530" width="140" height="30" as="geometry"/></mxCell><mxCell id="p3_lg4" value="" style="rounded=0;dashed=1;strokeWidth=2;fillColor=light-dark(#ffffff,#1a1a1a);strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="570" width="50" height="30" as="geometry"/></mxCell><mxCell id="p3_lg4t" value="차 밖으로 나가는 데이터" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="570" width="140" height="30" as="geometry"/></mxCell><mxCell id="p3_lg5" value="" style="rounded=1;arcSize=50;fillColor=light-dark(#eeeeee,#333333);strokeColor=#999999;fontColor=light-dark(#555555,#bbbbbb);html=1;" vertex="1" parent="1"><mxGeometry x="990" y="570" width="50" height="30" as="geometry"/></mxCell><mxCell id="p3_lg5t" value="안내 · 처리 안 함" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="570" width="140" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow-4" name="④ 이벤트 전 안내"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_title" value="④ 주행 이벤트 전 안내 — 차량 (핵심 기능 1)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p4_E1" value="주행 이벤트 감지" style="rounded=1;arcSize=50;fillColor=light-dark(#d5e8d4,#1f3b1f);strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="p4_E2" value="이 이벤트의 카드가&#xa;사본에 있나?" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="220" height="100" as="geometry"/></mxCell><mxCell id="p4_E2n" value="안내 안 함" style="rounded=1;arcSize=50;fillColor=light-dark(#eeeeee,#333333);strokeColor=#999999;fontColor=light-dark(#555555,#bbbbbb);whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="200" height="60" as="geometry"/></mxCell><mxCell id="p4_E3" value="안내 단계 정하기&#xa;시행일 전 공포 · 후 시행 후" style="rounded=0;fillColor=light-dark(#dae8fc,#1d3a5c);strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="470" width="200" height="60" as="geometry"/></mxCell><mxCell id="p4_E4" value="이 프로필이 이 단계를&#xa;이미 받았나?" style="shape=rhombus;perimeter=rhombusPerimeter;fillColor=light-dark(#e1d5e7,#3b2a45);strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="570" width="220" height="100" as="geometry"/></mxCell><mxCell id="p4_E4n" value="안내 안 함 (이미 알림)" style="rounded=1;arcSize=50;fillColor=light-dark(#eeeeee,#333333);strokeColor=#999999;fontColor=light-dark(#555555,#bbbbbb);whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeomet