# 서버(EC2) 배포용 환경변수 예시
# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.

# MySQL
DB_URL=jdbc:mysql://mysql:3306/driverule?serverTimezone=Asia/Seoul
DB_USERNAME=driverule
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 검수 CMS API 키 (요청 헤더 X-Admin-Key). 비워 두면 관리자 API 가 막힌다
# 생성 예: openssl rand -hex 32
ADMIN_API_KEY=

# 국가법령정보 공동활용 Open API 인증값(OC) — 법령 개정 자동 수집 (결정 011)
# 비워 두면 수집하지 않는다. 신청 화면에 이 서버의 IP 를 등록해야 응답이 온다
LAW_API_OC=
# 아래는 기본값이 있어 보통 비워 둔다
# LAW_SYNC_LAW_IDS=001638,003395,007079   # 도로교통법 · 시행령 · 시행규칙 법령ID
# LAW_SYNC_CRON=0 30 6 * * *               # 매일 06:30 (Asia/Seoul)
# LAW_SYNC_LOOKBACK_DAYS=90
# LAW_SYNC_SINCE=2026-10-01

# LLM API 키 (모델 확정 후 이름 변경)
LLM_API_KEY=

# API 문서 (Swagger UI · /v3/api-docs). 외부에 공개하지 않을 환경에서는 false
API_DOCS_ENABLED=true
