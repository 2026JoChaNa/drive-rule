{
  "decisions": {
    "right_turn": {
      "schema": 2,
      "tables": [
        {
          "key": "approach",
          "title": "교차로 진입 전",
          "conditions": ["right_turn_traffic_light", "front_traffic_light"],
          "rows": [
            { "when": { "right_turn_traffic_light": "yes" }, "text": "approach.light_yes", "tts": "approach.light_yes" },
            { "when": { "right_turn_traffic_light": "no", "front_traffic_light": "red" }, "text": "approach.no_red", "tts": "approach.no_red" },
            { "when": { "right_turn_traffic_light": "no", "front_traffic_light": "green" }, "text": "approach.no_green", "tts": "approach.no_green" }
          ]
        },
        {
          "key": "crosswalk",
          "title": "돌아선 뒤 횡단보도",
          "conditions": ["crosswalk_light", "pedestrian_present"],
          "rows": [
            { "when": { "crosswalk_light": "green", "pedestrian_present": "yes" }, "text": "crosswalk.green_yes", "tts": "crosswalk.green_yes" },
            { "when": { "crosswalk_light": "green", "pedestrian_present": "no" }, "text": "crosswalk.green_no", "tts": "crosswalk.green_no" },
            { "when": { "crosswalk_light": "red" }, "text": "crosswalk.red", "tts": "crosswalk.red" }
          ]
        }
      ]
    },
    "shared_text": {
      "schema": 2,
      "tables": [
        {
          "key": "only",
          "title": "같은 문장이 두 행에",
          "conditions": ["crosswalk_light", "pedestrian_present"],
          "rows": [
            { "when": { "crosswalk_light": "green", "pedestrian_present": "yes" }, "text": "stop", "tts": "stop" },
            { "when": { "crosswalk_light": "green", "pedestrian_present": "no" }, "text": "same", "tts": "same" },
            { "when": { "crosswalk_light": "red" }, "text": "same", "tts": "same" }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "name": "조건 없음 → 첫 소표의 첫 조건을 묻는다",
      "decision": "right_turn",
      "given": {},
      "expect": { "status": "ASK", "ask": "right_turn_traffic_light" }
    },
    {
      "name": "기획 v6 2-4 대화 예시: 보행 신호 녹색만 → 보행자 있음·없음 두 문장을 함께",
      "decision": "right_turn",
      "given": { "crosswalk_light": "green" },
      "expect": { "status": "ANSWER", "texts": ["crosswalk.green_yes", "crosswalk.green_no"] }
    },
    {
      "name": "소표 조건을 다 주면 한 행",
      "decision": "right_turn",
      "given": { "crosswalk_light": "green", "pedestrian_present": "yes" },
      "expect": { "status": "ANSWER", "texts": ["crosswalk.green_yes"] }
    },
    {
      "name": "'잘 모르겠어요'(전방 신호 모름) → 남은 두 행을 함께",
      "decision": "right_turn",
      "given": { "right_turn_traffic_light": "no" },
      "expect": { "status": "ANSWER", "texts": ["approach.no_red", "approach.no_green"] }
    },
    {
      "name": "when 에 없는 조건은 상관없음 — 신호등 있음 행도 후보",
      "decision": "right_turn",
      "given": { "front_traffic_light": "green" },
      "expect": { "status": "ANSWER", "texts": ["approach.light_yes", "approach.no_green"] }
    },
    {
      "name": "보행 신호 모름 + 보행자 있음 → 녹색·적색 행",
      "decision": "right_turn",
      "given": { "pedestrian_present": "yes" },
      "expect": { "status": "ANSWER", "texts": ["crosswalk.green_yes", "crosswalk.red"] }
    },
    {
      "name": "두 소표에서 후보 4개 → 첫 소표에서 갈리는 조건을 묻는다",
      "decision": "right_turn",
      "given": { "front_traffic_light": "green", "crosswalk_light": "green" },
      "expect": { "status": "ASK", "ask": "right_turn_traffic_light" }
    },
    {
      "name": "두 소표 모두 정해지면 한 행씩 모아서 (COLLECT)",
      "decision": "right_turn",
      "given": { "right_turn_traffic_light": "no", "front_traffic_light": "green", "crosswalk_light": "green", "pedestrian_present": "no" },
      "expect": { "status": "ANSWER", "texts": ["approach.no_green", "crosswalk.green_no"] }
    },
    {
      "name": "후보 3개, 첫 소표는 이미 하나 → 갈리는 두 번째 소표 조건을 묻는다",
      "decision": "right_turn",
      "given": { "right_turn_traffic_light": "yes", "pedestrian_present": "no" },
      "expect": { "status": "ASK", "ask": "crosswalk_light" }
    },
    {
      "name": "같은 문장은 하나로 센다 — 두 행이 걸려도 문장은 하나",
      "decision": "shared_text",
      "given": { "pedestrian_present": "no" },
      "expect": { "status": "ANSWER", "texts": ["same"] }
    }
  ]
}
