<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- No vehicle, location, overlay, network, or foreground-service permission
         is needed until its platform integration is implemented and verified. -->
    <application
        android:name=".DriveRuleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_drive_rule"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveRule"
        android:usesCleartextTraffic="false">
        <!-- Deliberately not marked distractionOptimized before AAOS validation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
