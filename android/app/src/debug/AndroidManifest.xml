<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sample mode is explicit opt-in. Real host and read permissions are declared in main. -->
    <application>
        <!-- adb am start로만 실행하는 무화면 확인 Activity. 런처에 노출하지 않는다. -->
        <activity
            android:name=".core.platform.carprobe.CarProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".core.platform.background.SampleGuidanceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Debug-only ten-minute synthetic event notification and local TTS demonstration across app switches; no real driving signals or legal guidance." />
        </service>
        <receiver android:name=".core.platform.background.StopSampleGuidanceReceiver"
            android:exported="false" />
    </application>
</manifest>
